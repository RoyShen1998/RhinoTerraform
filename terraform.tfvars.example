# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored, so nothing you put there is published.
#
# AWS credentials do NOT go in this file. Terraform reads them from your AWS
# CLI configuration (run `aws configure`) or the AWS_* environment variables.

# Required. S3 bucket names are global, so choose a name of your own.
bucket_name = "my-rhino-site-bucket"

# Optional settings -----------------------------------------------------------

# aws_region  = "ap-southeast-2"
# aws_profile = "my-profile"

# Rekognition Custom Labels model (contains your AWS account id).
# rekognition_model_arn = "arn:aws:rekognition:ap-southeast-2:111122223333:project/my-project/version/my-version/1700000000000"

# Only needed when the other repositories are not checked out next to this one.
# rhino_backend_path       = "C:/path/to/backend"
# rhino_angular_build_path = "C:/path/to/frontend/dist/rhino-identifier/browser"
